# Подключение к Postgres (значения по умолчанию совпадают с docker-compose)
DATABASE_URL=postgres://multigames:multigames@localhost:5432/multigames?sslmode=disable

# Подключение к Redis
REDIS_URL=redis://localhost:6379/0

# Секрет для JWT (обязательно смени в продакшене)
JWT_SECRET=your-secret-key-min-32-chars

# Секрет для однократного создания первого админа (в curl передай тот же в X-Admin-Init-Secret)
ADMIN_INIT_SECRET=my-super-secret

# Включение логирования запросов/фронтенда в app_logs (для отладки presence в админке)
APP_LOG_ENABLED=true

# Файл логов (сначала пишем сюда), файл оффсета импорта и интервал импорта в БД (секунды)
APP_LOG_FILE=logs/app_events.jsonl
APP_LOG_STATE_FILE=logs/app_events.offset
APP_LOG_SYNC_INTERVAL_SECONDS=5

# Web Push (PWA). Сгенерировать пару:
#   go run github.com/SherClockHolmes/webpush-go/cmd/...  или см. README webpush-go GenerateVAPIDKeys
# Без ключей push отключён (сервер стартует).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zozu.games

# Очистка старых логов из БД:
# APP_LOG_RETENTION_DAYS=30  (0 = не удалять)
# APP_LOG_CLEANUP_INTERVAL_SECONDS=3600
