# Подключение к Postgres (значения по умолчанию совпадают с docker-compose)
DATABASE_URL=postgres://multigames:multigames@localhost:5432/multigames?sslmode=disable

# Подключение к Redis
REDIS_URL=redis://localhost:6379/0

# Секрет для JWT (обязательно смени в продакшене)
JWT_SECRET=your-secret-key-min-32-chars

# Секрет для однократного создания первого админа (в curl передай тот же в X-Admin-Init-Secret)
ADMIN_INIT_SECRET=my-super-secret

# Включение логирования запросов/фронтенда в app_logs (для отладки presence в админке)
APP_LOG_ENABLED=true

# Файл логов (сначала пишем сюда), файл оффсета импорта и интервал импорта в БД (секунды)
APP_LOG_FILE=logs/app_events.jsonl
APP_LOG_STATE_FILE=logs/app_events.offset
APP_LOG_SYNC_INTERVAL_SECONDS=5

# Web Push (PWA). Сгенерировать пару:
#   go run github.com/SherClockHolmes/webpush-go/cmd/...  или см. README webpush-go GenerateVAPIDKeys
# Без ключей push отключён (сервер стартует).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# webpush-go сам добавит mailto: — указывайте email БЕЗ префикса (или https://…).
# "mailto:…" тоже ок: сервер нормализует, иначе Apple отвечает 403.
VAPID_SUBJECT=admin@zozu.games

# Android FCM (закрытое приложение). JSON сервис-аккаунта Firebase
# с ролью Firebase Cloud Messaging API Admin. Без ключа FCM выключен.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Очистка старых логов из БД:
# APP_LOG_RETENTION_DAYS=30  (0 = не удалять)
# APP_LOG_CLEANUP_INTERVAL_SECONDS=3600

# Публичный URL API и фронта (для OAuth redirect_uri и callback)
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# --- Почта: коды подтверждения при регистрации ---
# Рекомендуется Resend (https://resend.com → API Keys).
# Письмо всегда уходит на email из формы регистрации (поле to).
# После верификации домена в Resend — From с вашего домена:
MAIL_FROM=ZozuGames <noreply@zozugames.com>
# Пока домен не подтверждён: MAIL_FROM=ZozuGames <onboarding@resend.dev>
# (тогда Resend доставляет только на email аккаунта Resend).
RESEND_API_KEY=

# Альтернатива — SMTP (Gmail/Yandex и т.п.), если RESEND_API_KEY пуст.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth (оставьте пустым — кнопки скрыты). Redirect URI:
#   {PUBLIC_BASE_URL}/api/auth/oauth/{google|apple|yandex|vk}/callback
# Автоперевод чата: по умолчанию MyMemory (без ключа).
# Опционально свой LibreTranslate:
# LIBRETRANSLATE_URL=https://libretranslate.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
# Universal Links (apple-app-site-association). Пустой Team ID — файл не отдаётся.
# Bundle прод-приложения; на DEV можно оставить тот же, домен DEV в AASA не входит.
APPLE_APP_BUNDLE_ID=com.zozugames.app
# Android App Links: SHA-256 сертификата подписи Play (App signing и upload), через запятую.
# Play Console → App integrity → App signing key certificate. Без отпечатков assetlinks.json = 404,
# кнопка «Открыть в приложении» при этом работает.
ANDROID_APP_LINK_SHA256=
ANDROID_APP_LINK_PACKAGE=com.zozugames.app
APPLE_KEY_ID=
# PEM ключ (.p8), можно с литералами \n
APPLE_PRIVATE_KEY=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
