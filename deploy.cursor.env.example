# =========================
# Deploy config for Cursor/Fly
# =========================

# Fly API token (create with: fly tokens create deploy -a <APP_NAME> -x 24h -n "cursor-deploy")
FLY_API_TOKEN=replace_with_fly_deploy_token

# Fly app name (from fly.toml: app = '...')
FLY_APP_NAME=multigameszozu

# Required app secrets
JWT_SECRET=replace_with_long_random_secret
ADMIN_INIT_SECRET=replace_with_admin_init_secret

# Optional app secrets
# REDIS_URL=redis://...
APP_LOG_ENABLED=false
# APP_LOG_FILE=logs/app_events.jsonl
# APP_LOG_STATE_FILE=logs/app_events.offset
# APP_LOG_SYNC_INTERVAL_SECONDS=5
# APP_LOG_RETENTION_DAYS=30
# APP_LOG_CLEANUP_INTERVAL_SECONDS=3600
