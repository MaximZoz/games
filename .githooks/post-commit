#!/usr/bin/env bash
# После коммита обновляет WHAT_NEW.md и дописывает в тот же коммит (amend).
set -euo pipefail

# Избежать рекурсии amend → post-commit → amend.
if [[ "${WHATS_NEW_HOOK:-}" == "1" ]]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Только на feature-ветках (не на голом develop/main).
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
case "$branch" in
  develop|main|master|HEAD) exit 0 ;;
esac

if [[ ! -x "$ROOT/scripts/update_whats_new.sh" ]]; then
  chmod +x "$ROOT/scripts/update_whats_new.sh" 2>/dev/null || true
fi

"$ROOT/scripts/update_whats_new.sh" origin/develop >/dev/null 2>&1 || \
  "$ROOT/scripts/update_whats_new.sh" develop >/dev/null 2>&1 || true

git add WHAT_NEW.md server/cmd/server/whats_new.md 2>/dev/null || true
if git diff --cached --quiet; then
  exit 0
fi

# Не трогать, если коммит не наш «обычный» (merge/amend уже идёт).
if [[ -f "$ROOT/.git/MERGE_HEAD" ]]; then
  exit 0
fi

export WHATS_NEW_HOOK=1
git commit --amend --no-edit --no-verify --quiet
