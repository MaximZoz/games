# =========================
# Deploy config for Fly DEV
# =========================
# cp deploy.dev.env.example deploy.dev.env
# Заполни токен и секреты, затем:
#   ./launcher/setup_fly_dev.sh
#   UPDATE_SECRETS=1 ./launcher/deploy_dev.sh   # первый раз / смена секретов
#   ./launcher/deploy_dev.sh                   # обычный деплой кода (JWT не трогает)

# Fly API token (можно тот же org token, что и для прода)
# fly tokens create deploy -a multigameszozu-dev -x 72h -n "cursor-dev-deploy"
# ВАЖНО: значение в кавычках — в токене есть пробел после "FlyV1".
FLY_API_TOKEN="replace_with_fly_deploy_token"

# Имена ресурсов DEV (не должны совпадать с продом)
FLY_APP_NAME=multigameszozu-dev
FLY_DEV_DB_NAME=multigameszozu-dev-db
FLY_REGION=ams

# Обязательные секреты приложения (отдельные от прода!)
# Кавычки желательны (в secret могут быть + / =).
JWT_SECRET="replace_with_long_random_dev_secret"
ADMIN_INIT_SECRET="replace_with_admin_init_dev_secret"

# URL самого DEV-приложения
PUBLIC_BASE_URL=https://multigameszozu-dev.fly.dev
FRONTEND_URL=https://multigameszozu-dev.fly.dev

# Опционально
# REDIS_URL=rediss://default:PASSWORD@HOST:6379
APP_LOG_ENABLED=false
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=ZozuGames Dev <noreply@example.com>
