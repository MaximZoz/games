# Скопируй в key.properties (НЕ коммить key.properties и .jks/.keystore):
#   cp key.properties.example key.properties
#
# storeFile — путь относительно client/android/app/
# если keystore лежит в client/android/upload-keystore.jks → ../upload-keystore.jks

storePassword=your_store_password
keyPassword=your_key_password
keyAlias=zozugames
storeFile=../upload-keystore.jks
